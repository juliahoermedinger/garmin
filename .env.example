# Copy this file to .env and fill in real values.

# Random secret used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet key used to encrypt stored Garmin session tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_ENC_KEY=

# SQLite by default (fine for local dev). In production on a host with no persistent
# disk (e.g. Render's free tier), point this at a free Postgres instead (e.g. Neon.tech) -
# note the "+psycopg" in the scheme, since this app uses the psycopg3 driver:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///./running_tracker.db

# How often (minutes) the background job auto-syncs every connected user's Garmin runs.
SYNC_INTERVAL_MINUTES=30

# Set to "true" once deployed behind real HTTPS (e.g. on Render) so the session
# cookie is marked Secure. Leave "false" for local http://127.0.0.1 development.
COOKIE_SECURE=false
